pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_URI',       defaultValue: '',
               description: 'Full image URI, e.g. 123456789012.dkr.ecr.ap-south-1.amazonaws.com/registration-app:42')
        string(name: 'AWS_REGION',      defaultValue: 'ap-south-1', description: 'AWS region of the EKS cluster')
        string(name: 'CLUSTER_NAME',    defaultValue: '',           description: 'EKS cluster name')
        string(name: 'KUBE_NAMESPACE',  defaultValue: 'registration',     description: 'Kubernetes namespace')
        string(name: 'KUBE_DEPLOYMENT', defaultValue: 'registration-app', description: 'Deployment name')
        string(name: 'KUBE_CONTAINER',  defaultValue: 'registration-app', description: 'Container name in the deployment')
        string(name: 'K8S_DIR',         defaultValue: 'registration_App/k8s', description: 'Folder with the Kubernetes manifests')
    }

    environment {
        KUBECONFIG = "${WORKSPACE}/.kube/config"   // isolated; avoids the stale default config
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    ['IMAGE_URI', 'AWS_REGION', 'CLUSTER_NAME', 'KUBE_NAMESPACE',
                     'KUBE_DEPLOYMENT', 'KUBE_CONTAINER', 'K8S_DIR'].each { p ->
                        if (!params[p]?.trim()) { error("${p} is required") }
                    }
                    if (!(params.IMAGE_URI ==~ /^[A-Za-z0-9][A-Za-z0-9._\/:@-]*$/)) {
                        error('IMAGE_URI contains unsupported characters')
                    }
                    if (!(params.AWS_REGION ==~ /^[a-z0-9-]+$/)) {
                        error('AWS_REGION contains unsupported characters')
                    }
                    ['CLUSTER_NAME', 'KUBE_NAMESPACE', 'KUBE_DEPLOYMENT', 'KUBE_CONTAINER'].each { p ->
                        if (!(params[p] ==~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/)) {
                            error("${p} contains unsupported characters")
                        }
                    }
                    if (!(params.K8S_DIR ==~ /^[A-Za-z0-9._\/-]+$/)) {
                        error('K8S_DIR contains unsupported characters')
                    }
                }
                sh 'kubectl version --client'
                sh 'aws --version'
            }
        }

        stage('Configure kubeconfig (IAM role)') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$(dirname "$KUBECONFIG")"
                    aws sts get-caller-identity          # should show the CI role
                    aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$AWS_REGION"
                    kubectl config view --minify | grep server
                    kubectl get ns
                '''
            }
        }

        stage('Apply Kubernetes resources') {
            steps {
                sh '''
                    set -eu
                    kubectl apply -f "$K8S_DIR/namespace.yaml"
                    kubectl apply -f "$K8S_DIR/configmap.yaml"
                    kubectl apply -f "$K8S_DIR/service.yaml"
                    kubectl apply -f "$K8S_DIR/secret.yaml"
                    kubectl apply -f "$K8S_DIR/ingress.yaml"
                    kubectl -n "$KUBE_NAMESPACE" get configmap registration-app-config
                    kubectl -n "$KUBE_NAMESPACE" get secret registration-app-secret
                '''
            }
        }

        stage('Deploy image') {
            steps {
                sh '''
                    set -eu
                    sed -i "s|^\\([[:space:]]*image:\\).*|\\1 ${IMAGE_URI}|" "$K8S_DIR/deployment.yaml"
                    grep -n "image:" "$K8S_DIR/deployment.yaml"
                    kubectl apply -f "$K8S_DIR/deployment.yaml"
                    kubectl -n "$KUBE_NAMESPACE" rollout status deployment/"$KUBE_DEPLOYMENT" --timeout=180s
                '''
            }
        }

        stage('Wait for load balancer') {
            steps {
                sh '''
                    set -eu
                    for attempt in $(seq 1 30); do
                        INGRESS_ADDRESS=$(kubectl -n "$KUBE_NAMESPACE" get ingress registration-app \
                            -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                        if [ -n "$INGRESS_ADDRESS" ]; then
                            echo "Application URL: http://$INGRESS_ADDRESS"
                            exit 0
                        fi
                        echo "Waiting for AWS load balancer address (attempt $attempt/30)..."
                        sleep 10
                    done
                    echo "Ingress load balancer address was not assigned in time"
                    kubectl -n "$KUBE_NAMESPACE" describe ingress registration-app || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment completed with image: ${params.IMAGE_URI}"
        }
        failure {
            sh 'kubectl -n "$KUBE_NAMESPACE" get pods -o wide || true'
            sh 'kubectl -n "$KUBE_NAMESPACE" describe deployment "$KUBE_DEPLOYMENT" || true'
        }
    }
}