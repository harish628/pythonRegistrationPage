pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_URI',
            defaultValue: '',
            description: 'Full container image URI, for example 123456789012.dkr.ecr.ap-south-1.amazonaws.com/registration-app:42'
        )
    }

    environment {
        KUBE_NAMESPACE = 'registration'
        KUBE_DEPLOYMENT = 'registration-app'
        KUBE_CONTAINER = 'registration-app'
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    if (!params.IMAGE_URI?.trim()) {
                        error('IMAGE_URI is required')
                    }
                    if (!(params.IMAGE_URI ==~ /^[A-Za-z0-9][A-Za-z0-9._\/:@-]*$/)) {
                        error('IMAGE_URI contains unsupported characters')
                    }
                }
                sh 'kubectl version --client'
            }
        }

        stage('Apply Kubernetes resources') {
            steps {
                sh '''
                    set -eu
                    kubectl apply -f registration_App/k8s/namespace.yaml
                    kubectl apply -f registration_App/k8s/configmap.yaml
                    kubectl apply -f registration_App/k8s/service.yaml
                    kubectl apply -f registration_App/k8s/secret.yaml
                    kubectl apply -f registration_App/k8s/ingress.yaml
                    kubectl -n "$KUBE_NAMESPACE" get configmap registration-app-config
                    kubectl -n "$KUBE_NAMESPACE" get secret registration-app-secret
                '''
            }
        }

        stage('Deploy image') {
            steps {
                sh '''
                    sed -i "s|^[[:space:]]*image:.*|          image: ${IMAGE_URI}|" registration_App/k8s/deployment.yaml

                    cat registration_App/k8s/deployment.yaml

                    kubectl apply -f registration_App/k8s/deployment.yaml

                    kubectl -n ${KUBE_NAMESPACE} rollout status deployment/${KUBE_DEPLOYMENT} --timeout=180s
                '''
            }
        }

        stage('Wait for load balancer') {
            steps {
                sh '''
                    set -eu
                    for attempt in $(seq 1 30); do
                        INGRESS_ADDRESS=$(kubectl -n "$KUBE_NAMESPACE" get ingress registration-app \
                            -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                        if [ -n "$INGRESS_ADDRESS" ]; then
                            echo "Application URL: http://$INGRESS_ADDRESS"
                            exit 0
                        fi
                        echo "Waiting for AWS load balancer address (attempt $attempt/30)..."
                        sleep 10
                    done
                    echo "Ingress load balancer address was not assigned in time"
                    kubectl -n "$KUBE_NAMESPACE" describe ingress registration-app || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment completed with image: ${params.IMAGE_URI}"
        }
        failure {
            sh 'kubectl -n "$KUBE_NAMESPACE" get pods -o wide || true'
            sh 'kubectl -n "$KUBE_NAMESPACE" describe deployment "$KUBE_DEPLOYMENT" || true'
        }
    }
}
