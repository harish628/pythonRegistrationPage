pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_URI',
            defaultValue: '',
            description: 'Full container image URI, for example 123456789012.dkr.ecr.ap-south-1.amazonaws.com/registration-app:42'
        )
    }

    environment {
        KUBE_NAMESPACE = 'registration'
        KUBE_DEPLOYMENT = 'registration-app'
        KUBE_CONTAINER = 'registration-app'
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    if (!params.IMAGE_URI?.trim()) {
                        error('IMAGE_URI is required')
                    }
                    if (!(params.IMAGE_URI ==~ /^[A-Za-z0-9][A-Za-z0-9._\/:@-]*$/)) {
                        error('IMAGE_URI contains unsupported characters')
                    }
                }
                sh 'kubectl version --client'
            }
        }

        stage('Apply Kubernetes resources') {
            steps {
                sh '''
                    set -eu
                    kubectl apply -f k8s/namespace.yaml
                    kubectl apply -f k8s/configmap.yaml
                    kubectl apply -f k8s/service.yaml
                '''
            }
        }

        stage('Deploy image') {
            steps {
                                withEnv(["DEPLOY_IMAGE=${params.IMAGE_URI}"]) {
                                        sh '''
                                                set -eu
                                                kubectl apply -f k8s/deployment.yaml
                                                kubectl -n "$KUBE_NAMESPACE" set image \
                                                    deployment/$KUBE_DEPLOYMENT \
                                                    $KUBE_CONTAINER="$DEPLOY_IMAGE"
                                                kubectl -n "$KUBE_NAMESPACE" rollout status \
                                                    deployment/$KUBE_DEPLOYMENT --timeout=180s
                                        '''
                                }
            }
        }
    }

    post {
        success {
            echo "Deployment completed with image: ${params.IMAGE_URI}"
        }
        failure {
            sh 'kubectl -n "$KUBE_NAMESPACE" get pods -o wide || true'
            sh 'kubectl -n "$KUBE_NAMESPACE" describe deployment "$KUBE_DEPLOYMENT" || true'
        }
    }
}
